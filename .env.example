# Django
DJANGO_SECRET_KEY=django-insecure-change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=jobpulse
MYSQL_USER=jobpulse
MYSQL_PASSWORD=jobpulsepass

# MongoDB
MONGO_URI=mongodb://admin:adminpass@127.0.0.1:27017
MONGO_DB=jobpulse

# JWT
JWT_SECRET=jwt-secret-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# Gemini LLM
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Adzuna (free tier - sign up at https://developer.adzuna.com/)
# Required only for the `adzuna` source. Set ADZUNA_COUNTRY to change market.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173